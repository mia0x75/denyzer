{
  "$schema": "./node_modules/knip/schema.json",
  // Keep generated shadcn primitives, but check the custom UI components.
  "ignore": [
    "src/components/ui/{badge,button,card,chart,command,dialog,input,label,popover,select,skeleton,switch,table,tooltip}.tsx"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-knipignore"]
}
